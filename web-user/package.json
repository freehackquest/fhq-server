{
  "name": "web-user",
  "version": "0.2.56",
  "repository": {
    "type": "git",
    "url": "git://github.com/freehackquest/fhq-server.git"
  },
  "scripts": {
    "ng": "ng",
    "start": "export NODE_OPTIONS=--openssl-legacy-provider && ng serve fhq-frontend --host 0.0.0.0",
    "build": "export NODE_OPTIONS=--openssl-legacy-provider && ng build fhq-frontend",
    "build_log": "export NODE_OPTIONS=--openssl-legacy-provider && ng build fhq-frontend > build-log.txt  2>&1",
    "build-prod": "export NODE_OPTIONS=--openssl-legacy-provider && ng build fhq-frontend --configuration production",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "migrate": "ng generate @angular/material:mdc-migration"
  },
  "browserslist": [
    "last 2 versions",
    "not ie <= 11",
    "not ie_mob <= 11"
  ],
  "private": true,
